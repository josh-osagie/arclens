---
interface Props {
	command?: string;
}

const { command = 'npx arclens analyze ./src --insights' } = Astro.props;
---

<div class="copy-command">
	<div class="copy-command__row">
		<code class="copy-command__code">{command}</code>
		<button type="button" class="copy-command__btn" data-copy={command} aria-label="Copy command">
			<svg class="copy-command__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.75"></rect>
				<path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
			</svg>
			<span class="copy-command__btn-text">Copy</span>
		</button>
	</div>
	<p class="copy-command__hint">
		Then run <code>npx arclens view</code> to open the interactive graph on your machine.
	</p>
</div>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');

	for (const button of buttons) {
		button.addEventListener('click', async () => {
			const text = button.getAttribute('data-copy');
			if (!text) return;

			try {
				await navigator.clipboard.writeText(text);
				const label = button.querySelector('.copy-command__btn-text');
				if (label) {
					const original = label.textContent;
					label.textContent = 'Copied!';
					button.classList.add('copy-command__btn--copied');
					window.setTimeout(() => {
						label.textContent = original;
						button.classList.remove('copy-command__btn--copied');
					}, 2000);
				}
			} catch {
				// Clipboard API unavailable; selection fallback is enough for most cases.
			}
		});
	}
</script>

<style>
	.copy-command {
		width: 100%;
		max-width: 42rem;
		margin: 0 auto 2rem;
		text-align: center;
	}

	.copy-command__row {
		display: flex;
		align-items: stretch;
		border: 1px solid var(--al-border);
		border-radius: 0.5rem;
		background: var(--al-surface);
		overflow: hidden;
		text-align: left;
	}

	.copy-command__code {
		flex: 1;
		margin: 0;
		padding: 0.875rem 1.125rem;
		font-family: var(--al-font-mono);
		font-size: clamp(0.8125rem, 2.5vw, 0.875rem);
		line-height: 1.4;
		overflow-x: auto;
		white-space: nowrap;
		color: var(--al-text);
		background: transparent;
	}

	.copy-command__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		flex-shrink: 0;
		margin: 0;
		padding: 0 1rem;
		border: 0;
		border-left: 1px solid var(--al-border);
		background: transparent;
		color: var(--al-muted);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.copy-command__btn:hover {
		color: var(--al-text);
		background: color-mix(in srgb, var(--al-border) 40%, transparent);
	}

	.copy-command__btn--copied {
		color: var(--al-accent);
	}

	.copy-command__icon {
		flex-shrink: 0;
		opacity: 0.7;
	}

	.copy-command__hint {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
		color: var(--al-muted);
	}

	.copy-command__hint code {
		font-family: var(--al-font-mono);
		font-size: 0.85em;
		color: var(--al-accent);
	}
</style>
