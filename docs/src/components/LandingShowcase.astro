---
interface Props {
	src?: string;
	alt?: string;
	caption?: string;
}

const {
	src = '/images/viewer/graph-overview.png',
	alt = 'Arclens viewer exploring a React dependency graph',
	caption = 'Local interactive graph — components, hooks, and dependency edges at a glance.',
} = Astro.props;
---

<figure class="landing-showcase">
	<div class="landing-showcase__frame">
		<div class="landing-showcase__chrome">
			<span class="landing-showcase__dot" aria-hidden="true"></span>
			<span class="landing-showcase__dot" aria-hidden="true"></span>
			<span class="landing-showcase__dot" aria-hidden="true"></span>
			<span class="landing-showcase__url">arclens view</span>
		</div>
		<img class="landing-showcase__img" src={src} alt={alt} loading="lazy" width="1200" height="675" />
	</div>
	<figcaption class="landing-showcase__caption">{caption}</figcaption>
</figure>

<style>
	.landing-showcase {
		margin: 3rem auto 1rem;
		max-width: 56rem;
		padding: 0 1rem;
	}

	.landing-showcase__frame {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.85rem;
		background: var(--al-surface);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--al-brand-sky) 12%, transparent),
			0 24px 48px rgba(0, 0, 0, 0.45),
			0 0 80px color-mix(in srgb, var(--al-brand-indigo) 8%, transparent);
		overflow: hidden;
	}

	.landing-showcase__chrome {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: color-mix(in srgb, var(--al-canvas) 80%, var(--al-surface));
	}

	.landing-showcase__dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--sl-color-gray-4);
	}

	.landing-showcase__dot:nth-child(1) {
		background: #f87171;
	}

	.landing-showcase__dot:nth-child(2) {
		background: #fbbf24;
	}

	.landing-showcase__dot:nth-child(3) {
		background: #34d399;
	}

	.landing-showcase__url {
		margin-left: 0.5rem;
		font-family: var(--al-font-mono);
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.landing-showcase__img {
		display: block;
		width: 100%;
		height: auto;
		vertical-align: middle;
	}

	.landing-showcase__caption {
		margin: 0.85rem 0 0;
		font-size: 0.9rem;
		text-align: center;
		color: var(--sl-color-gray-3);
	}
</style>
