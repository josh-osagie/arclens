---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}

const {
  src = "/images/viewer/graph-overview.png",
  alt = "Arclens viewer exploring a React dependency graph",
  caption = "Local interactive graph with components, hooks, and dependency edges at a glance.",
} = Astro.props;
---

<figure class="landing-showcase">
  <div class="landing-showcase__frame">
    <img
      class="landing-showcase__img"
      src={src}
      alt={alt}
      loading="lazy"
      width="1200"
      height="675"
    />
  </div>
  <figcaption class="landing-showcase__caption">{caption}</figcaption>
</figure>

<style>
  .landing-showcase {
    width: 100%;
    max-width: var(--al-showcase-width);
    margin: 0 auto 2.5rem;
  }

  .landing-showcase__frame {
    border: 1px solid var(--al-border);
    border-radius: 0.625rem;
    background: var(--al-surface);
    box-shadow: var(--al-shadow-md);
    overflow: hidden;
  }

  .landing-showcase__img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .landing-showcase__caption {
    margin: 0.875rem 0 0;
    font-size: 0.875rem;
    text-align: center;
    color: var(--al-muted);
  }
</style>
