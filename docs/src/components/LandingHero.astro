---
import logo from '../assets/arclens-logo.svg';

interface Props {
	tagline?: string;
}

const {
	tagline = 'Static analysis for React. Interactive dependency graph on your machine.',
} = Astro.props;
---

<section class="landing-hero" aria-labelledby="landing-title">
	<img class="landing-hero__logo" src={logo.src} alt="" width="56" height="56" />
	<h1 id="landing-title" class="landing-hero__title">Arclens</h1>
	<p class="landing-hero__tagline">{tagline}</p>
	<div class="landing-hero__actions">
		<a class="landing-hero__cta landing-hero__cta--primary" href="/getting-started/">Get started</a>
		<a
			class="landing-hero__cta landing-hero__cta--secondary"
			href="https://github.com/josh-osagie/arclens"
			target="_blank"
			rel="noopener noreferrer"
		>
			GitHub
		</a>
	</div>
</section>

<style>
	.landing-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(2.5rem, 6vw, 3.75rem) 0 clamp(1.25rem, 3vw, 1.75rem);
		text-align: center;
	}

	.landing-hero__logo {
		display: block;
		width: 3.5rem;
		height: 3.5rem;
		margin-bottom: 1.25rem;
	}

	.landing-hero__title {
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--al-text);
	}

	.landing-hero__tagline {
		margin: 0.875rem 0 0;
		max-width: 33.75rem;
		font-size: 1.0625rem;
		font-weight: 400;
		line-height: 1.55;
		color: var(--al-muted);
	}

	.landing-hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.landing-hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 8.5rem;
		padding: 0.625rem 1.25rem;
		border-radius: 0.375rem;
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.25;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.landing-hero__cta--primary {
		border: 1px solid var(--al-accent);
		background: var(--al-accent);
		color: #ffffff;
	}

	.landing-hero__cta--primary:hover {
		border-color: var(--al-accent-hover);
		background: var(--al-accent-hover);
		color: #ffffff;
	}

	.landing-hero__cta--secondary {
		border: 1px solid var(--al-border);
		background: transparent;
		color: var(--al-text);
	}

	.landing-hero__cta--secondary:hover {
		border-color: var(--al-border-strong);
		background: var(--al-surface-raised);
	}
</style>
