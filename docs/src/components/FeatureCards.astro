---
const features = [
	{
		title: 'Map your architecture',
		accent: 'component',
		descriptionHtml:
			'Scan React and TypeScript projects to discover components, hooks, contexts, utilities, and how they connect.',
	},
	{
		title: 'Interactive viewer',
		accent: 'entry',
		descriptionHtml:
			'Run <code>npx arclens view</code> locally. Explore the graph on your machine from <code>graph.json</code>, not a hosted dashboard.',
	},
	{
		title: 'Terminal insights',
		accent: 'utility',
		descriptionHtml:
			'Print node counts, top connections, external libraries, and optional architecture hints right in the CLI.',
	},
	{
		title: 'Live watch mode',
		accent: 'hook',
		descriptionHtml:
			'Re-analyze on file changes with <code>arclens watch</code> while the viewer auto-refreshes as your graph evolves.',
	},
];

---

<section class="feature-cards" aria-labelledby="features-heading">
	<h2 id="features-heading" class="feature-cards__heading">Built for React codebases</h2>
	<p class="feature-cards__lead">
		From first scan to interactive exploration, everything runs locally on your machine.
	</p>
	<div class="feature-cards__list">
		{
			features.map((feature) => (
				<article class={`feature-card feature-card--${feature.accent}`}>
					<div class="feature-card__inner">
						<span class="feature-card__type">
							<span class="feature-card__type-dot" aria-hidden="true" />
							{feature.accent}
						</span>
						<h3 class="feature-card__title">{feature.title}</h3>
						<p class="feature-card__desc" set:html={feature.descriptionHtml} />
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.feature-cards {
		width: 100%;
		margin: 0 auto 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--al-border);
	}

	.feature-cards__heading {
		margin: 0;
		font-size: clamp(1.25rem, 3vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-align: center;
		color: var(--al-text);
	}

	.feature-cards__lead {
		margin: 0.625rem auto 0;
		max-width: 36rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		text-align: center;
		color: var(--al-muted);
	}
</style>
