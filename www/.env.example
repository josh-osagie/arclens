# =============================================================================
# Arclens Marketing Site (www/) — Environment Variables
# =============================================================================
# Copy this file to `.env` (or configure each key in your hosting provider:
# Vercel Dashboard → Project → Settings → Environment Variables).
# NEVER commit the real `.env` file to git — it contains API keys.

# -----------------------------------------------------------------------------
# Site basics (public — safe to expose in client JS via import.meta.env.PUBLIC_*)
# -----------------------------------------------------------------------------

# Pro sales on the marketing site. Omit or leave unset = "Coming soon" (no checkout).
# Set to "true" only when @arclens/pro, Paddle fulfillment, and license flow are live.
PUBLIC_PRO_AVAILABLE=

# Docs site URL or path prefix. Use "/docs" for Starlight under the same host,
# or a full URL like "https://docs.arclens.dev" if hosted separately.
PUBLIC_DOCS_URL=/docs

# Canonical site origin for sitemap, OG tags, and absolute checkout links.
# NOTE: Astro also exposes the built-in SITE var; we support either.
# Examples: "https://arclens.dev"  (prod)   "http://localhost:4321" (local)
PUBLIC_SITE_URL=
SITE_URL=

# -----------------------------------------------------------------------------
# Paddle Billing — public checkout URLs (safe for client JS)
# -----------------------------------------------------------------------------
# These are the "shareable checkout links" you copy from the Paddle dashboard:
#   Catalog → Prices → (pick a price) → Share / Checkout link
# They go in `PUBLIC_*` because the marketing site's pricing page links to
# them directly from the user's browser.
#
# Leave empty to fall back to the /#pricing anchor (useful before prices
# are live in Paddle or during local UI work).

# Direct checkout link for the Pro plan (monthly / yearly — whatever variant
# you pick when copying the URL). The pricing grid "Get Pro" button uses this.
PUBLIC_PADDLE_CHECKOUT_PRO=

# Reserved for a future Team / Seat-based plan. Leave empty for now.
PUBLIC_PADDLE_CHECKOUT_TEAM=

# -----------------------------------------------------------------------------
# Paddle Billing — SERVER-SIDE ONLY (KEEP THESE SECRET)
# -----------------------------------------------------------------------------
# Do NOT prefix these with PUBLIC_.  They should only live on the server
# (Astro SSR functions, API routes like /api/paddle-webhook.ts) and must
# NEVER be bundled into the browser build.

# Paddle API key — used for back-end server-to-server REST calls:
# fetching transactions, managing subscriptions, creating checkouts dynamically,
# pulling usage data, etc.
#
# Get one here:
#   Developer Tools → Authentication → API keys
#   → "New API key" → copy the value (starts with "api_test_" in sandbox,
#     "api_prod_" in live).
#
# Needed by (future):
#   - Server-side checkout creation (custom pricing / per-seat)
#   - Subscription management from a support dashboard
#   - Syncing customers/subscriptions into your DB
PADDLE_API_KEY=

# Notification signing secret — used to authenticate requests hitting the
# /api/paddle-webhook.ts endpoint.  This is NOT the API key above; it's
# unique PER NOTIFICATION DESTINATION you create in the dashboard.
#
# Get one here:
#   Developer Tools → Notifications
#   → Create or open the destination that points to /api/paddle-webhook
#   → Under "Secret" click the eye → copy the string (usually prefixed
#     "pdl_ntfset_").
#
# The webhook handler refuses to process payloads whose HMAC-SHA256
# signature doesn't match this value.  KEEP IT PRIVATE.
PADDLE_NOTIFICATION_SECRET=

# Paddle Seller (vendor) numeric ID.  Required for server-side flows that
# build relationships in Paddle Billing API payloads and for loading Paddle.js
# in inline/overlay checkout scenarios.
#
# Find it:
#   Developer Tools → Authentication
#   → Your seller ID is displayed near the top.
#     (You can also GET https://api.paddle.com/event-types and check the
#     `seller_id` returned in headers, or find it in any API response.)
PADDLE_SELLER_ID=

# Paddle Client token — used by Paddle.js for the overlay checkout on the
# client side. This is NOT the API key above; it's a publishable token safe
# to ship to browsers.
#
# Get one here:
#   Developer Tools → Authentication → Client tokens
#   → "New client token" → copy the value (starts with "test_" in sandbox,
#     "live_" in live).
PUBLIC_PADDLE_CLIENT_TOKEN=test_554586c5796ecdfaee0146e4b4a
PUBLIC_PADDLE_ENV=sandbox

# Price IDs for server-side checkout creation.  The checkout URL is tied
# to a specific PRICE of a product (e.g. "Pro Monthly" vs "Pro Yearly").
# You need these if you want to build custom checkout sessions (with
# discounts, custom data, etc.) from the server instead of using the
# PUBLIC_PADDLE_CHECKOUT_* share links.
#
# Find a Price ID:
#   Catalog → Prices → open the price
#   → URL ends in `/prices/pri_01hxxxxxxxxx` → pri_01hxxxxxxxxx is the ID.
#
# PADDLE_PRICE_ID_PRO = the "Pro" price (monthly/yearly — whichever is your
# default Pro price).  Add more rows for each additional tier.
PADDLE_PRICE_ID_PRO=
