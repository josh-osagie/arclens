---
import { DOCS_URL, GITHUB_URL, NPM_URL } from "../data/tiers";
---

<footer class="border-t border-line bg-[rgba(0,0,0,0.25)] pt-10 pb-6 sm:pt-12">
  <div
    class="wrap mb-6 grid gap-8 sm:mb-8 md:grid-cols-[1.2fr_1.5fr] md:gap-10"
  >
    <div>
      <a
        class="mb-3 inline-flex items-center gap-2 font-display text-text no-underline hover:text-text"
        href="/"
      >
        <img src="/arclens-logo.svg" alt="" width="24" height="24" />
        <span>Arclens</span>
      </a>
      <p class="max-w-88 text-[0.9375rem] text-text-muted">
        Local-first architecture explorer for React and TypeScript.
      </p>
    </div>

    <nav
      class="grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-6"
      aria-label="Footer"
    >
      <div class="grid content-start gap-2">
        <p
          class="mb-1 font-mono text-[0.6875rem] tracking-wider text-text-muted uppercase"
        >
          Product
        </p>
        <a
          class="text-[0.9rem] text-text-body no-underline hover:text-accent-strong"
          href="#pricing">Pricing</a
        >
        <a
          class="text-[0.9rem] text-text-body no-underline hover:text-accent-strong"
          href="#get-started">Get started</a
        >
        <a
          class="text-[0.9rem] text-text-body no-underline hover:text-accent-strong"
          href={DOCS_URL}>Docs</a
        >
      </div>
      <div class="grid content-start gap-2">
        <p
          class="mb-1 font-mono text-[0.6875rem] tracking-wider text-text-muted uppercase"
        >
          Links
        </p>
        <a
          class="flex items-center gap-2 text-[0.9rem] text-text-body no-underline hover:text-accent-strong group"
          href={NPM_URL}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-text-muted group-hover:text-accent-strong transition-colors"><path d="M4 4v16h16V4H4zm13 13h-3v-7h-2v7H7V7h10v10z"/></svg>
          npm
        </a>
        <a
          class="flex items-center gap-2 text-[0.9rem] text-text-body no-underline hover:text-accent-strong group"
          href={GITHUB_URL}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-text-muted group-hover:text-accent-strong transition-colors"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33c.85 0 1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
          GitHub
        </a>
        <a
          class="flex items-center gap-2 text-[0.9rem] text-text-body no-underline hover:text-accent-strong group"
          href="mailto:joshx.dev@gmail.com?subject=Arclens%20contact"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-text-muted group-hover:text-accent-strong transition-colors"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5l-8-5V6l8 5l8-5v2z"/></svg>
          Contact
        </a>
      </div>
      <div class="grid content-start gap-2">
        <p
          class="mb-1 font-mono text-[0.6875rem] tracking-wider text-text-muted uppercase"
        >
          Legal
        </p>
        <a
          class="text-[0.9rem] text-text-body no-underline hover:text-accent-strong"
          href="/terms">Terms</a
        >
        <a
          class="text-[0.9rem] text-text-body no-underline hover:text-accent-strong"
          href="/privacy">Privacy</a
        >
      </div>
    </nav>
  </div>
  <div class="wrap border-t border-line pt-4 sm:pt-5">
    <p class="text-base text-text-muted">
      © {new Date().getFullYear()} Arclens
    </p>
  </div>
</footer>
