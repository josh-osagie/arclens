---
export interface Props {
  country?: string;
}

const { country } = Astro.props;

import { ANALYZE_CMD, DOCS_URL, INSTALL_CMD } from "../data/tiers";
import { steps, whyFreeItems } from "../data/content";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import PricingGrid from "./PricingGrid";
import HeroTypewriter from "./HeroTypewriter";
import ArchGraph from "./ArchGraph";
import EditorialMotion from "./EditorialMotion";
import TerminalDemo from "./TerminalDemo";
---

<Nav />
<main class="editorial-landing bg-ink text-text">
  <!-- Terminal-first hero -->
  <section
    class="hero-section relative border-b border-line overflow-hidden"
    id="get-started"
    aria-labelledby="hero-title"
  >
    <div
      class="hero-graph-wrap pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <ArchGraph client:load />
    </div>

    <div
      class="wrap relative z-[1] grid items-center gap-8 py-10 lg:grid-cols-[1.5fr_1.05fr] lg:gap-12 lg:py-16"
    >
      <div>
        <p
          class="mb-3 font-mono text-[0.6875rem] tracking-[0.25em] text-accent uppercase"
        >
          React architecture explorer
        </p>
        <h1
          id="hero-title"
          class="mb-3 font-display text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.05] tracking-tight"
        >
          <HeroTypewriter client:load />
        </h1>
        <p
          class="mb-6 max-w-md text-[0.9375rem] leading-relaxed text-text-body"
        >
          Static analysis → interactive graph. Understand unfamiliar codebases
          in minutes.
        </p>
        <div class="cta-row flex flex-col gap-3 mt-6 sm:flex-row sm:items-center sm:gap-4">
          <div class="relative w-full sm:w-[240px]">
            <button
              type="button"
              class="js-install-btn btn btn-primary rounded-none w-full sm:w-[240px] group relative overflow-hidden transition-all duration-300 h-11 border border-transparent hover:border-accent"
            >
              <span class="absolute inset-0 flex items-center justify-center transition-transform duration-300 group-hover:-translate-y-full">
                Install free CLI
              </span>
              <span class="absolute inset-0 flex items-center justify-center translate-y-full transition-transform duration-300 group-hover:translate-y-0 font-mono text-sm bg-accent text-ink">
                <span class="js-install-btn-text">{INSTALL_CMD}</span>
              </span>
            </button>
          </div>
          <a class="btn btn-ghost rounded-none" href={DOCS_URL}>Docs</a>
        </div>
        <p class="mt-3 max-w-md text-[0.8125rem] leading-relaxed text-text-muted">
          The npm package is the free tier — analyze, watch, and view locally.
          <a class="text-text-body underline-offset-2 hover:text-accent hover:underline" href="#pricing">Pro</a> is coming soon.
        </p>
      </div>

      <div id="install">
        <TerminalDemo client:load />
      </div>
    </div>
  </section>

  <!-- Connected vertical timeline spine glow -->
  <div class="relative overflow-hidden">
    <div class="left-1/2 top-0 bottom-0 w-[1px] -translate-x-1/2 bg-gradient-to-b from-accent/40 via-line-strong to-transparent pointer-events-none hidden md:block"></div>

    <!-- Product screenshot (2 Columns) -->
    <section
      class="js-reveal border-b border-line py-16 sm:py-20 relative z-10"
      id="demo"
      aria-labelledby="demo-title"
    >
      <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
        <!-- Left Column: Copy & Insights -->
        <div class="space-y-6">
          <div>
            <p
              class="font-mono text-[0.6875rem] tracking-widest text-accent uppercase"
            >
              Product
            </p>
            <h2 id="demo-title" class="mt-2 text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-tight">
              From files to architecture
            </h2>
            <p class="mt-3 text-lg font-medium text-accent/90">
              Without running the app.
            </p>
          </div>

          <p class="text-[0.9375rem] leading-relaxed text-text-body">
            Arclens uses static AST analysis to map your entire React and TypeScript project in seconds — rendering an interactive node-graph without requiring a dev server or build step.
          </p>

          <div class="space-y-4 pt-2 border-t border-line">
            <div class="flex items-start gap-3">
              <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-accent/15 text-accent text-xs font-bold font-mono">✓</div>
              <div>
                <h4 class="text-sm font-semibold text-text">Zero-Runtime Parsing</h4>
                <p class="text-xs text-text-body">Parses JSX, hooks, context, and import graphs safely without executing untrusted code.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-accent/15 text-accent text-xs font-bold font-mono">✓</div>
              <div>
                <h4 class="text-sm font-semibold text-text">Interactive Neighborhood Focus</h4>
                <p class="text-xs text-text-body">Isolate any component or utility and examine upstream/downstream dependents instantly.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-none bg-accent/15 text-accent text-xs font-bold font-mono">✓</div>
              <div>
                <h4 class="text-sm font-semibold text-text">100% Local & Private</h4>
                <p class="text-xs text-text-body">Your codebase never leaves your filesystem. No external uploads or cloud dependencies.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Overview with Parallax -->
        <div class="relative js-parallax-img">
          <div class="absolute -inset-1 rounded-none bg-gradient-to-r from-accent/20 to-accent/5 opacity-50 blur-xl"></div>
          <figure class="relative rounded-none border border-line-strong bg-ink-elevated overflow-hidden shadow-2xl">
            <img
              src="/images/graph-overview.png"
              alt="Arclens graph viewer"
              class="block w-full h-auto"
              width="1440"
              height="900"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section
      class="js-reveal border-b border-line py-16 sm:py-20 relative z-10"
      id="how"
      aria-labelledby="how-title"
    >
      <div class="wrap">
        <div class="text-center max-w-xl mx-auto mb-10">
          <p
            class="font-mono text-[0.6875rem] tracking-widest text-accent uppercase"
          >
            How it works
          </p>
          <h2 id="how-title" class="mt-2 text-[clamp(1.5rem,3vw,2.25rem)] font-bold tracking-tight">
            Run a command. Get a graph.
          </h2>
          <p class="mt-2 text-sm text-text-muted">No config files, no build step, no runtime required.</p>
        </div>
        <div class="mt-4 grid gap-px border border-line bg-line md:grid-cols-3 rounded-none overflow-hidden shadow-xl">
          {
            steps.map((step) => (
              <article class="js-parallax-card bg-ink p-6 sm:p-8 flex flex-col justify-between hover:bg-ink-elevated transition-colors rounded-none">
                <div>
                  <span class="mono mb-4 inline-block rounded-none border border-accent/30 bg-accent/10 px-2.5 py-0.5 font-mono text-xs text-accent">
                    {step.n}
                  </span>
                  <h3 class="mb-2 font-display text-[1.1rem] font-semibold text-text">
                    {step.title}
                  </h3>
                  <p class="text-[0.875rem] leading-relaxed text-text-body">
                    {step.body}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why Free -->
    <section
      class="js-reveal border-b border-line py-16 sm:py-20 relative z-10"
      id="why-free"
      aria-labelledby="why-title"
    >
      <div class="wrap grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch">
        <div class="border border-line rounded-none bg-ink-elevated p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <p
              class="font-mono text-[0.6875rem] tracking-widest text-accent uppercase"
            >
              Free tier
            </p>
            <h2 id="why-title" class="mt-2 mb-4 text-[clamp(1.5rem,3vw,2.25rem)] font-bold tracking-tight">
              Built for your day job and side projects.
            </h2>
            <p class="mb-6 text-[0.9375rem] leading-relaxed text-text-body">
              Most React apps are small enough to map locally. Install Arclens, run
              analyze, and explore the graph without signing up or hitting a paywall
              on day one. Pro is there when the repo gets big enough that you feel
              the limits, not before.
            </p>
          </div>
          <button
            type="button"
            class="js-install-btn btn btn-primary rounded-none w-full sm:w-[240px] group relative overflow-hidden transition-all duration-300 h-11 border border-transparent hover:border-accent"
          >
            <span class="absolute inset-0 flex items-center justify-center transition-transform duration-300 group-hover:-translate-y-full">
              Install free CLI
            </span>
            <span class="absolute inset-0 flex items-center justify-center translate-y-full transition-transform duration-300 group-hover:translate-y-0 font-mono text-sm bg-accent text-ink">
              <span class="js-install-btn-text">{INSTALL_CMD}</span>
            </span>
          </button>
        </div>
        <div class="grid gap-px border border-line bg-line sm:grid-cols-2 rounded-none overflow-hidden">
          {
            whyFreeItems.map((item) => (
              <div class="flex flex-col justify-start bg-ink p-6 sm:p-7 hover:bg-ink-elevated transition-colors rounded-none">
                <span class="mono mb-2 block font-mono text-[0.625rem] tracking-wider text-accent uppercase">
                  {item.tag}
                </span>
                <h3 class="mb-2 font-display text-[0.95rem] font-semibold text-text">
                  {item.title}
                </h3>
                <p class="text-sm leading-relaxed text-text-body">
                  {item.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <PricingGrid client:visible className="js-reveal border-b border-line relative z-10" country={country} />
  </div>

  <section class="js-reveal py-12 sm:py-16" aria-labelledby="docs-title">
    <div
      class="wrap flex flex-wrap items-center justify-between gap-4 border border-line-strong p-6 sm:p-8"
    >
      <div>
        <p
          class="font-mono text-[0.6875rem] tracking-wider text-accent uppercase"
        >
          Documentation
        </p>
        <h2 id="docs-title" class="mt-1 text-[clamp(1.25rem,2.5vw,1.75rem)]">
          Prefer to read first?
        </h2>
      </div>
      <a class="btn btn-secondary" href={DOCS_URL}>Open docs</a>
    </div>
  </section>
</main>
<Footer />
<EditorialMotion client:load />

<script define:vars={{ installCmd: INSTALL_CMD }}>
  const installBtns = document.querySelectorAll(".js-install-btn");

  installBtns.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const textSpan = btn.querySelector(".js-install-btn-text");
      const cmd = installCmd;
      try {
        await navigator.clipboard.writeText(cmd);
        if (textSpan) {
          textSpan.textContent = "Copied!";
          setTimeout(() => {
            textSpan.textContent = cmd;
          }, 2000);
        }
      } catch {
        if (textSpan) {
          textSpan.textContent = "Failed";
          setTimeout(() => {
            textSpan.textContent = cmd;
          }, 2000);
        }
      }
    });
  });
</script>
