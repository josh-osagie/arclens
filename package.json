{
  "name": "arclens",
  "version": "2.0.0",
  "description": "Arclens — React architecture explorer. Statically map components, hooks, and dependencies into an interactive graph.",
  "main": "dist/cli.js",
  "bin": {
    "arclens": "bin/arclens.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "arclens": "tsx src/cli.ts",
    "analyze": "tsx src/cli.ts analyze",
    "analyze:watch": "tsx src/cli.ts watch",
    "build": "tsc && node scripts/copy-viewer.mjs",
    "build:viewer": "pnpm --dir viewer build",
    "prebuild": "pnpm build:viewer",
    "dev:viewer": "tsx src/cli.ts view --dev",
    "dev:docs": "pnpm --dir docs dev",
    "build:docs": "pnpm --dir docs build",
    "dev": "pnpm dev:viewer",
    "dev:watch": "bash scripts/dev-watch.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "release:publish": "pnpm build && npm publish --access public && node scripts/git-release-tag.mjs",
    "release:patch": "npm version patch --no-git-tag-version && pnpm build && npm publish --access public && node scripts/git-release-tag.mjs",
    "release:minor": "npm version minor --no-git-tag-version && pnpm build && npm publish --access public && node scripts/git-release-tag.mjs",
    "release:major": "npm version major --no-git-tag-version && pnpm build && npm publish --access public && node scripts/git-release-tag.mjs",
    "release:patch:dry": "pnpm build && npm publish --dry-run --access public"
  },
  "keywords": [
    "react",
    "architecture",
    "graph",
    "arclens",
    "typescript",
    "static-analysis",
    "dependency-graph",
    "devtools",
    "cli"
  ],
  "author": "JoshX <joshx.dev@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "react": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCalmCrasher/arclens.git"
  },
  "homepage": "https://github.com/JCalmCrasher/arclens#readme",
  "bugs": {
    "url": "https://github.com/JCalmCrasher/arclens/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
