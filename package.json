{
  "name": "react-atlas",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "react-atlas": "tsx src/cli.ts",
    "analyze": "tsx src/cli.ts analyze",
    "analyze:watch": "chokidar \"samples/**/*.{ts,tsx}\" \"src/**/*.ts\" -i node_modules -c \"pnpm analyze\" --initial",
    "dev:viewer": "pnpm --dir viewer dev",
    "dev": "\"pnpm dev:viewer\"",
    "dev:watch": "concurrently -n analyze,viewer -c blue,yellow \"pnpm analyze:watch\" \"pnpm dev:viewer\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "react": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
