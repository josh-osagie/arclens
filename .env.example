# =============================================================================
# Arclens CLI (root) — Environment Variables
# =============================================================================
# Copy this file to `.env` for local CLI development, or set these in CI
# when building / publishing the npm package.
#
# The CLI reads these at runtime via `process.env`.  They do NOT affect the
# marketing site (www/) — that lives in www/.env.

# -----------------------------------------------------------------------------
# Site & checkout links surfaced in the CLI
# -----------------------------------------------------------------------------
# The CLI prints these URLs when a user hits a plan limit, runs
# `arclens upgrade`, or gets a Pro feature hint.  Override them in CI /
# special builds so beta builds can point at a staging checkout, for
# example.

# Canonical marketing site URL. Used as the base for pricing / docs links.
# Example: "https://arclens.dev"
ARCLENS_SITE_URL=

# Direct buy link for the Pro plan shown in CLI upgrade messaging.
# (e.g. `arclens upgrade` output, plan-limit error footer).
# This is the same shareable Paddle Billing checkout URL you'd also put in
# www/.env → PUBLIC_PADDLE_CHECKOUT_PRO.
# (Get one from Paddle dashboard: Catalog → Prices → pick a price → Share link)
#
# Leave empty and the CLI falls back to ${ARCLENS_SITE_URL}/#pricing.
ARCLENS_CHECKOUT_PRO=

# Reserved for a future Team/Enterprise plan checkout link.
ARCLENS_CHECKOUT_TEAM=

# -----------------------------------------------------------------------------
# Paddle Billing API (server-side flows from CLI backend helpers)
# -----------------------------------------------------------------------------
# NOTE: The server-side Paddle notification/webhook signing secret lives in
# www/.env → PADDLE_NOTIFICATION_SECRET, because webhook endpoints run on
# the marketing site (www/).  The CLI itself never verifies webhook signatures.

# Base URL for Paddle Billing REST API calls.
#   - Live:    https://api.paddle.com
#   - Sandbox: https://sandbox-api.paddle.com
# Defaults to live if unset.
ARCLENS_PADDLE_API_BASE_URL=

# Paddle Seller (vendor) numeric ID.  Used by CLI server-side helpers that
# build Paddle Billing API relationships or construct signed checkout URLs.
# This matches www/.env → PADDLE_SELLER_ID (you can copy the same value).
ARCLENS_PADDLE_SELLER_ID=

# -----------------------------------------------------------------------------
# Pro plugin / registry (for `arclens install-pro`)
# -----------------------------------------------------------------------------
# Arclens Pro ships its Pro-only features as a separately-installed npm
# package (this keeps the free tier lean and prevents accidentally bundling
# paid code with `npm install -g arclens`).
#
# ARCLENS_PRO_REGISTRY tells `arclens install-pro` which npm registry to
# pull the @arclens/pro package from:
#
#   - For PUBLIC npm release:  leave empty (uses default npm registry)
#                              OR set "https://registry.npmjs.org/"
#   - For a private registry (GitHub Packages / GitLab / private npm):
#     e.g. "https://npm.pkg.github.com/@arclens"
#
# Users with a license key will run:  npx arclens install-pro <license-key>
# which (eventually) validates the key with Paddle Billing and then installs
# the Pro addon from this registry.
ARCLENS_PRO_REGISTRY=

# -----------------------------------------------------------------------------
# Pricing / docs fallback links (optional)
# -----------------------------------------------------------------------------
# Fallback pricing URL used when ARCLENS_CHECKOUT_PRO is not set.
# Defaults to ${ARCLENS_SITE_URL}/#pricing if empty.
ARCLENS_PRICING_URL=
